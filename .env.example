# Copy to .env; replace placeholders. Never commit .env.
DATABASE_URL=postgresql://cia_app:REPLACE_ME@localhost:5432/customer_intelligence
ADMIN_DATABASE_URL=postgresql://postgres:REPLACE_ME@localhost:5432/customer_intelligence
# Role cia_analyst has SELECT privileges only on explicitly approved tables/views.
SQL_DATABASE_URL=postgresql://cia_analyst:REPLACE_ME@localhost:5432/customer_intelligence
POSTGRES_PASSWORD=REPLACE_ME
APP_DB_PASSWORD=REPLACE_ME
ANALYST_DB_PASSWORD=REPLACE_ME
APP_ENV=local
MODEL_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
READER_API_KEY=
REVIEWER_API_KEY=
# Optional reproducible demo date; omit for UTC today's date.
BUSINESS_DATE=2026-09-16
